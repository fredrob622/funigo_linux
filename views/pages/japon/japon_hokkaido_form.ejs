

<%- include('../../partials/hokkaido/header_hokkaido') %>

<body>
    <div class="content content-black"> 
        <div id=japon-ile-titre>
            <h2 ><%= title %></h2><br>
            <button type="button" id="btn-back" class="vocab_href"> ← Page précédente </button>
        </div>
        
        <div id="japongeo-contenaire1">

            <div id="japongeo1">

                <a href="/images/cartes/japon/hokkaido/global_Hokkaido_prefecture2.webp" target="_blank">
                    <img src="/images/cartes/japon/hokkaido/global_Hokkaido_prefecture2.webp" alt="Carte hokkaido">
                </a>

            </div>

            <div id="japongeo2">

                <p>
                    <h2 class="japongeoh2">La grande île du nord</h2> <br>

                   <span class="vocab_span_bold">Hokkaido 北海道</span>"chemin de la Mer du Nord " lorsque l'on traduit les kanjis.<br><br>

                    <span class="vocab_span_bold">Hokkaido 北海道</span> est la deuxième par la superficie des quatre grandes îles du Japon. <br><br>

                    La superficie est d'environ <span class="vocab_span_bold">83 456,64 km2</span>.<br><br>
                    
                    La population de <span class="vocab_span_bold">Hokkaido 北海道</span> est d'environ <span class="vocab_span_bold">5.7 millions</span> d'habitants.<br><br>

                </p>


                <p>
                    <h2 class="japongeoh2">Les villes de Hokkaido</h2> <br><br>
                
                </p>
                    <div id="japongeo2-bis">
                        <div>

                            <a href="/japon_hokkaido_sapporo">
                                <img src="/images/cartes/japon/hokkaido/Sapporo.webp" alt="Sapporo">
                            </a>
                            <p>
                            <a href="/japon_hokkaido_sapporo" class="geo_href">Sapporo</a></p>

                        </div>    

                        <div>

                            <a href="/japon_hokkaido_hakodate">
                                <img src="/images/cartes/japon/hokkaido/Hakodate.webp" alt="Hakodate">
                            </a>
                            <p>
                            <a href="/japon_hokkaido_hakodate" class="geo_href">Hakodate</a></p>

                        </div>  

                        <div>

