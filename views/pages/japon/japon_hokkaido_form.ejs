                                <img src="/images/cartes/japon/hokkaido/Asahikawa.webp" alt="Asahikawa">
                            </a>
                            <p>
                            <a href="/japon_hokkaido_asahikawa" class="geo_href">Asahikawa</a></p>

                        </div>  

                        <div>

                            <a href="/japon_hokkaido_otaru">
                                <img src="/images/cartes/japon/hokkaido/Otaru.webp" alt="Otaru">
                            </a>
                            <p>
                            <a href="/japon_hokkaido_otaru" class="geo_href">Otaru</a></p>

                        </div>  

                        <div>

                            <a href="/japon_hokkaido_kushiro">
                                <img src="/images/cartes/japon/hokkaido/Kushiro.webp" alt="Kushiro">
                            </a>
                            <p>
                            <a href="/japon_hokkaido_kushiro" class="geo_href">Kushiro</a></p>

                        </div>  

                        <div>

                            <a href="/japon_hokkaido_otaru">
                                <img src="/images/cartes/japon/hokkaido/Otaru.webp" alt="Otaru">
                            </a>
                            <p>
                            <a href="/japon_hokkaido_otaru" class="geo_href">Otaru</a></p>

                        </div>
                        
                        <div>

                            <a href="/japon_hokkaido_shiraoi">
                                <img src="/images/cartes/japon/hokkaido/Shiraoi.webp" alt="Shiraoi">
                            </a>
                            <p>
                            <a href="/japon_hokkaido_shiraoi" class="geo_href">Shiraoi</a></p>

                        </div>


                    </div>

            </div>


        </div>

        <div id="japongeo-contenaire2">

            <div id="japongeo3">            

                <a href="/video/japon/clip-hokkaido.webm" target="_blank">
                    <video autoplay loop muted playsinline>
                        <source src="/video/japon/clip-hokkaido.webm" type="video/webm">
                    </video>
                </a>

            </div>

            <div id="japongeo4">   

                <a href="/images/cartes/japon/hokkaido/carte-hokkaido1.webp" target="_blank">
                    <img src="/images/cartes/japon/hokkaido/carte-hokkaido1.webp" alt="Carte Hokkaido">
                </a>

            </div>

        </div>

             <br>

        <div id="japongeo-contenaire3">    

        
            <div id="japongeo5">
                <p>
                    <h2 class="japongeoh2">Administratif</h2> <br>

                     <span class="vocab_span_bold">Hokkaido 北海道</span> est à la fois une région et une préfecture

                     <span class="vocab_span_bold">Hokkaido 北海道</span> est divisée en quatorze sous-préfectures.<br><br>

                </p>


            </div>

            <div id="japongeo6">

                <a href="/images/cartes/japon/hokkaido/hokkaido_prefecture2.webp" target="_blank">
                    <img src="/images/cartes/japon/hokkaido/hokkaido_prefecture2.webp" alt="Carte Hokkaido">
                </a>

            </div>

        </div>

             <br>

        <div id="japongeo-contenaire4">    

            <div id="japongeo7">
                <p> 

                   <h2 class="japongeoh2">Transport Hokkaido</h2> <br>

                   <h3 class="japongeoh3"><u>Le train</u></h3>

                   <span class="vocab_span_bold">Hokkaido 北海道</span> est relié  par le Shinkansen à <span class="vocab_span_bold">Honshu 本州</span><br><br>

                   <h3 class="japongeoh3"><u>L'avion</u></h3>

                   l'aéroport principal est l'aéroport <span class="vocab_span_bold">New Chitose</span> à Chitose.<br><br>

                </p>
            </div>
            
            <div id="japongeo8">

                <a href="/images/cartes/japon/hokkaido/train-hokkaido5.webp" target="_blank">
                    <img src="/images/cartes/japon/hokkaido/train-hokkaido5.webp" alt="Carte Hokkaido">
                </a>

            </div>
    
        </div> 
        <br>

        <div id="japongeo-contenaire5">    

            <div id="japongeo9">
                <p> 
                   <h2 class="japongeoh2">Sommets et volcans</h2>
                    <br>

                    Volcans actifs marqués (triangles rouges) :<br><br>

                    Mont Asahi-dake (2,291m) - au centre<br>
                    Mount Usu - Sud, près de la baie<br>
                    Mount Tarumae - Sud-est<br>
                    Mount Meakan (1,499m) - Est<br>
                    Mount Tokachi - Centre-est<br>
                    Mount Komagatake - Péninsule sud<br><br>

                    Principaux sommets (triangles noirs) :<br><br>

                    Mount Tomuraushi (2,141m) - Nord<br>
                    Mount Poroshiri (2,052m) - Nord<br>
                    Mount Rishiri (1,721m) - Île au nord-ouest<br>
                    Mount Rausu (1,660m) - Nord-est<br>
                    Daisetsuzan mountain group - Groupe montagneux central<br>
                    Mount Esan - Extrême sud
                    

                </p>
            </div>

            <div id="japongeo10">
                <p> 
                   <h2 class="japongeoh2">Relief</h2>
                    <br>
                    <a href="/images/cartes/japon/hokkaido/hokkaido-volcan2.webp" target="_blank">
                        <img src="/images/cartes/japon/hokkaido/hokkaido-volcan2.webp" alt="Carte Hokkaido">
                    </a>

                </p>

            </div>
        </div>
        <br><br>
        <div id="japongeo-contenaire6">    

            <div id="japongeo11">
               <p> 
                   <h2 class="japongeoh2">Carte Atlas</h2>
                    <br>
                    <a href="/images/cartes/japon/hokkaido/hokkaido-tourisme.webp" target="_blank">
                        <img src="/images/cartes/japon/hokkaido/hokkaido-tourisme.webp" alt="Carte Hokkaido">
                    </a>

                </p>
            </div>    
        </div>            
    </div>
  <!-- ******************* css -->

  <style>

    * { margin: 0; padding: 0;    }

    body {  height: 100vh;  display: flex;   }
	
    .japongeoh2 { background-color: #074107; color: white; padding: 10px; margin:auto; width: 250px; align-items: center; }
    .japongeoh3 {  color: white; padding: 10px; margin:auto; width: 250px; align-items: center;font-size: 1.0em; font-weight: 300px; }
    .geo_href { color: white; text-decoration: underline;  padding: 5px 10px ; border-radius: 5px; margin-right: 10px;  font-size: 1.0em; font-weight: 300px; width: 60px; display: inline-block; text-align: center;  }


            /*******************************/

	
    #japongeo-contenaire1 {  display: flex; margin-top: 30px; }


    #japongeo1 { width: 55%; height: auto; padding: 0; overflow: hidden; margin: auto}

    #japongeo1 img { width: 80%;  height: auto;  object-fit: cover;  display: block; margin: auto }

    #japongeo1 > a img { cursor: pointer; }

    #japongeo2 { width: 45%; height: auto;  margin-left: 15px;}

    #japongeo2 >  a:hover { background-color:#0056b3; transition: background-color 0.3s, color 0.3s;font-weight: bold;}

    #japongeo2-bis >  a:hover { background-color:#0056b3; transition: background-color 0.3s, color 0.3s;font-weight: bold;}

    #japongeo2-bis { width: 100%; display: flex; flex-direction: row; flex-wrap: wrap; gap: 15px; }

    #japongeo2-bis > div { display: flex; flex-direction: column; }

    #japongeo2-bis > div img { width: 80px; height: auto; object-fit: cover; }

    #japongeo2-bis > div p { margin: 5px 0 0 0;  }

            /*******************************/
            
    #japongeo-contenaire2 {  display: flex; margin-top: 20px; }


    #japongeo3 { width: 60%; height: auto; padding: 0; overflow: hidden; margin:auto}

    #japongeo3 video { width: 110%;  height: auto;  object-fit: cover;  display: block;  margin-left: -35px; }

    #japongeo4 { width: 40%; height: auto;  }

    #japongeo4 > p { margin-left: 50px; }

    #japongeo4 img { width: 110%;  height: auto;  object-fit: cover;  display: block; margin:auto; margin-left: -45px; }

    #japongeo4 > a img { cursor: pointer; }
  
            /*******************************/
            

    #japongeo-contenaire3 {  display: block; margin-top: 10px; }

    #japongeo6 { width: 100%; height: auto; padding: 0; overflow: hidden; margin: auto}

    #japongeo6 img { width: 80%;  height: auto;  object-fit: cover;  display: block; margin: auto; margin-left: auto;}

    #japongeo6 > a img { cursor: pointer; }
            
  
                /*******************************/
            

    #japongeo-contenaire4 {  display: flex; margin-top: 10px; }

    #japongeo7 { width: 30%; height: auto;  }

    #japongeo8 { width: 70%; height: auto; padding: 0; overflow: hidden; margin-left: 55px}

    #japongeo8 img { width: 95%;  height: auto;  object-fit: cover;  display: block;  margin-left: 15px }

    #japongeo8 > a img { cursor: pointer; }

                    /*******************************/
            

    #japongeo-contenaire5 {  display: flex; margin-top: 10px; }

    #japongeo9 { width: 40%; height: auto;  margin-left: -15px;}

    #japongeo10 { width: 60%; height: auto; padding: 0; overflow: hidden; margin: auto; }

    #japongeo10 img { width: 125%;  height: auto;  object-fit: cover;  display: block; margin: auto; }

    #japongeo10 > a img { cursor: pointer; }

                    /*******************************/
            

    #japongeo-contenaire6 {  display: flex; margin-top: 10px; } 

    #japongeo11 img { width: 95%;  height: auto;  object-fit: cover;  display: block; margin: auto; }
            


    .volcan-table {
        border-collapse: collapse; border: 2px solid rgb(140 140 140); font-family: sans-serif;
        font-size: 0.9rem; letter-spacing: 1px; width: 100%; /* Optionnel : pour qu'il prenne toute la largeur */
        color: white; /* Pour que le texte soit lisible sur le fond sombre */ background-color: #1a1a1a; }

    .volcan-thead { background-color: rgb(15, 15, 15);}

    .volcan-table th,
    .volcan-table td {border: 1px solid rgb(160 160 160);  text-align: left; padding-left:3px; }

    /* Centre le texte de la dernière colonne (Hiragana) */
    .volcan-table td:last-of-type { text-align: left; padding-left:3px; }

    /* Effet zébré pour les lignes paires */
    .volcan-tbody > tr:nth-of-type(even) {  background-color: rgb(15, 15, 15);    }

    /* Style pour mettre en avant les kanjis */
    .japanese-text { font-weight: bold; color: white; /* Un petit rouge discret pour le rappel du Japon */}

    @media screen and (max-width: 700px) {

        	
                        /*******************************/
           

        #japongeo-contenaire1 { display: flex;  flex-direction: column; }


        #japongeo1 { width: 90%; height: auto;  }

        #japongeo2 { width: 90%; height: auto; margin-left: 15px; margin: auto;  margin-top: 20px; }

        	
                        /*******************************/
            
        
        #japongeo-contenaire2 { display: flex; flex-direction: column; }


        #japongeo3 { width: 100%; margin-left: -30px;}           /* ← ajouté */

        #japongeo3 video { width: 130%; height: auto; object-fit: cover; margin: 0; } 

        #japongeo4 { width: 100%; height: auto;  margin: auto;  margin-top: 10px; }

        	
                        /*******************************/
            

        #japongeo-contenaire3 { display: flex; flex-direction: column; }


        #japongeo5 { width: 100%; height: auto; margin-left: 15px; margin: auto;  margin-top: 10px; }

        #japongeo6 { width: 90%; margin: auto; }           /* ← ajouté */

        /* #japongeo6 video { width: 100%; height: auto; object-fit: cover; margin: 0; }  */


                        /*******************************/
            

        #japongeo-contenaire4 {  display: flex; flex-direction: column;}


        #japongeo7 { width: 100%; height: auto;  margin: auto; margin-top: 10px;}
        
        #japongeo8 { width: 100%; height: auto; padding: 0; overflow: hidden; margin-top: 10px; margin:auto} */

        #japongeo8 img { width: 90%;  height: auto; object-fit: cover;   margin-top: 10px; margin-left: auto; }

        #japongeo8 > a img { cursor: pointer; }

                         /*******************************/
            

        #japongeo-contenaire5 {  display: flex; flex-direction: column; }


        #japongeo9 { width: 100%; height: auto;  margin: auto;  margin-top: 10px;}
        
        #japongeo10 { width: 100%; height: auto; padding: 0; overflow: hidden; margin-top: 10px;}

        #japongeo10 img { width: 95%;  height: auto;  object-fit: cover;  display: block; margin: auto; }

        #japongeo10 > a img { cursor: pointer; }       
                
        .volcan-table {
            border-collapse: collapse; border: 2px solid rgb(140 140 140); font-family: sans-serif;
            font-size: 0.8rem; letter-spacing: 1px; width: 100%; /* Optionnel : pour qu'il prenne toute la largeur */
            color: white; /* Pour que le texte soit lisible sur le fond sombre */ background-color: #1a1a1a; }

        .volcan-thead { background-color: rgb(15, 15, 15);}

        .volcan-table th,
        .volcan-table td {border: 1px solid rgb(160 160 160);  text-align: left; padding-left:3px; }

        /* Centre le texte de la dernière colonne (Hiragana) */
        .volcan-table td:last-of-type { text-align: left; padding-left:3px; }

        /* Effet zébré pour les lignes paires */
        .volcan-tbody > tr:nth-of-type(even) {  background-color: rgb(15, 15, 15);    }

        /* Style pour mettre en avant les kanjis */
        .japanese-text { font-weight: bold; color: white; /* Un petit rouge discret pour le rappel du Japon */}
    }


  </style>
