                    </thead>
                    <tbody class="volcan-tbody">
                        <tr>    <td>Mont Iwate</td><td>2 038 m</td><td>Actif</td>           </tr>
                        <tr>    <td>Mont Chōkai</td><td>2 236 m</td><td>Actif</td>		</tr>
                        <tr>    <td>Mont Zaō</td><td>1 841 m</td><td>Actif</td>              </tr>
                        <tr>    <td>Mont Bandai</td><td>1 816 m</td><td>Actif</td>           </tr>
                        <tr>    <td>Mont Azuma</td><td>2 035 m</td><td>Actif</td>            </tr>
                        <tr>    <td>Mont Hakkōda</td><td>1 585 m</td><td>Actif</td></tr>
                    </tbody>
                </table>
 
                </p>
            
            </div>

        </div> 

