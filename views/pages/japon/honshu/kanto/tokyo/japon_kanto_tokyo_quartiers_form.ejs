    #japongeo4 { width: 100%; height: auto;   padding: 0; overflow: hidden; margin: auto}

    #japongeo4 >  a:hover { background-color:#0056b3; transition: background-color 0.3s, color 0.3s;font-weight: bold;}

    #japongeo2-bis >  a:hover { background-color:#0056b3; transition: background-color 0.3s, color 0.3s;font-weight: bold;}

    #japongeo2-bis { width: 100%; display: flex; flex-direction: row; flex-wrap: wrap; gap: 15px; justify-content: center; margin: auto; align-items: center; margin-top: 20px; }

    #japongeo2-bis > div { display: flex; flex-direction: column; align-items: center; }

    #japongeo2-bis > div img { width: 150px; height: auto; object-fit: cover; }

    #japongeo2-bis > div p { margin: 5px 0 0 0; text-align: center; }


  
            /*******************************/       

    #japongeo-contenaire3 {  display: flex; margin-top: 10px; }

    #japongeo5 { width: 60%; height: auto; padding: 0; overflow: hidden; margin: auto; margin-top: 0 }

    #japongeo5 img { width: 100%;  height: auto;  object-fit: cover;  display: block; background-color: #a2ccf7;}

    #japongeo5 > a img { cursor: pointer; }

    #japongeo6 { width: 40%; height: auto;  margin-left: 35px;}



               /*******************************/       

    #japongeo-contenaire4 {  display: flex; margin-top: 10px; }

    #japongeo7 { width: 55%; height: auto;  }

    #japongeo7 img { width: 98%;  height: auto;  object-fit: cover;  display: block; }

    #japongeo7 > a img { cursor: pointer; }

    #japongeo8 { width: 45%; height: auto; padding: 0; overflow: hidden; margin: auto; margin-top: 0px; }

    #japongeo8 img { width: 100%;  height: auto;  object-fit: cover;  display: block; }

    #japongeo8 > a img { cursor: pointer; }

    .volcan-table {
        border-collapse: collapse; border: 2px solid rgb(140 140 140); font-family: sans-serif;
        font-size: 0.9rem; letter-spacing: 1px; width: 100%; /* Optionnel : pour qu'il prenne toute la largeur */white-space: normal; 
        color: white; /* Pour que le texte soit lisible sur le fond sombre */ background-color: #1a1a1a; }

    .volcan-thead { background-color: rgb(15, 15, 15);}

    .volcan-table th,
    .volcan-table td {border: 1px solid rgb(160 160 160);  text-align: center; padding-left:3px; padding-top: 3px; padding-bottom: 3px; }

    /* Centre le texte de la dernière colonne (Hiragana) */
    .volcan-table td:last-of-type {  padding-left:3px; text-align: center;white-space: normal; }

    /* Effet zébré pour les lignes paires */
    .volcan-tbody > tr:nth-of-type(even) {  background-color: rgb(15, 15, 15);  }

    /* Style pour mettre en avant les kanjis */
    .japanese-text { font-weight: bold; color: white; /* Un petit rouge discret pour le rappel du Japon */}
            


