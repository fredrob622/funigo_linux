        font-size: 1.0em; font-weight: 300px; width: 60px; display: inline-block; text-align: center;  }
    .geo_nu { color: white; padding: 5px 5px ; border-radius: 5px; margin-right: 5px;  
        font-size: 1.0em; font-weight: 300px; width: 50px; display: inline-block; text-align: center;  }  

            /*******************************/

	#japongeo-contenaire1 {  display: flex; margin-top: 30px; }

    #japongeo-contenaire1 > a > img { cursor: pointer; width: 98%; margin: auto; height: auto; object-fit: cover;  display: block;  }

    #japongeo-contenaire1 >  a:hover { background-color:#0056b3; transition: background-color 0.3s, color 0.3s;font-weight: bold;}

            /*******************************/
            
    #japongeo-contenaire2 {  display: flex; margin-top: 20px; width: 100%; margin: auto}

    /* #japongeo3 { width: 80%; height: auto; padding: 0; overflow: hidden; }

