<%- include('../../../../partials/header_vocab', { title: title }) %> 
<div class="content content-black">

    <div id="haut"></div>

    <div class="vocab_titre" >   
        <h2><%= title %></h2>
        <button type="button" id="btn-back" class="vocab_href"> ← Page précédente </button>
    </div>

    <% if (results && results.length > 0) { %>

        <!-- Barre audio : lecture du dialogue complet -->
        <div class="da-barre">
            <button type="button" id="da-play" class="vocab_href">🔊 Écouter le dialogue</button>
            <button type="button" id="da-stop" class="vocab_href">■ Arrêter</button>
            <label>Vitesse <input type="range" id="da-rate" min="0.5" max="1.5" step="0.1" value="0.9"></label>
            <label>Voix de femme <select id="da-vf"></select></label>
            <label>Voix d'homme <select id="da-vm"></select></label>
            <span id="da-msg"></span>
        </div>

    <% } %>

    <p class="texte-clignotant"><br>Cliquer sur une ligne pour avoir l'explication<br></p>

    <% if (results && results.length > 0) { %>

        <% results.forEach((article, index) => { %> 
    
            <div class="dialogue_article"> 
            
                <!-- Déterminer la classe à ajouter en fonction de l'index 
                si index est pair, on met la classe blog_dialogue_entete_even, sinon blog_dialogue_entete_odd 
                --> 

                <%  const alternateClass = (index % 2 === 0) ? 'blog_dialogue_entete_even' : 'blog_dialogue_entete_odd';  %>

                <!-- data-target-id="content-<%= index %>" : Un attribut personnalisé (data attribute) unique grâce à l'index (ex: content-0, content-1...). 
                Il sert très probablement à indiquer à un script JavaScript quel bloc de contenu (la traduction, l'explication, etc.) 
                il doit afficher ou masquer lorsqu'on clique sur cet en-tête. 
                article-dialogue-toggle classe « technique » marqueur pour le JavaScript -->


                <div class="dialogue_article_entete article-dialogue-toggle <%= alternateClass %>" data-target-id="content-<%= index %>"> 


                    <!-- <p><%= article.kanji %> <button type="button" class="da-ligne-btn" title="Écouter cette phrase">🔊</button></p> -->
                    <p>
                        <span><%= article.kanji %></span> 
                        <button type="button" class="da-ligne-btn" title="Écouter cette phrase">🔊</button>
                    </p>
                  
                </div>
                
            </div>


            <div class="blog_contenus_container bloc_dialogue_hidden" id="content-<%= index %>"> 
            
                <div class="blog_contenu">
                    <p> 
                       <%= article.hiragana %>  
                       <%= article.romanji %>   
                       <%= article.francais %>  <br>

                       <u>explication</u>: <br>
                       <%= article.explication %>      

                    </p>                             
                </div>  

            </div>
        <% }); %>

    <% } else { %>
        <p>Aucune onomatopée phrase trouvée.</p>
    <% } %>
</div>

<style>

    .dialogue_article { margin-top: 10px }
    .article-dialogue-toggle p { 
        display: flex; 
        align-items: center; 
        justify-content: space-between; /* Pousse le texte à gauche et le bouton à droite */
        width: 100%;                     /* Occupe toute la largeur du conteneur */
    }
    .dialogue_article_entete { display: flex;  justify-content: space-between; flex-direction: row; 
        background-color:  white; color: black; font-size: 0.9em;  border-radius: 5px; margin-left: 5px; 
        margin-right: 5px; cursor: pointer;  }
    /* Style pour les titres pairs (index 0, 2, 4, etc.) */
    /* .blog_dialogue_entete_even { background-color: #181616; color: #fcf7f7; } */
    .blog_dialogue_entete_even { background-color: #642b2b;  color: #fcf7f7; }

    /* Style pour les titres impairs (index 1, 3, 5, etc.) */
    .blog_dialogue_entete_odd { background-color: #642b2b;  color: #f7f2f2; }
    /* Cache l'élément qui porte cette classe (le conteneur des contenus) */
    .bloc_dialogue_hidden { display: none !important; }

    /* Barre audio */
    .da-barre { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 10px 5px; color: #fcf7f7; font-size: 0.85em; }
    .da-barre select { max-width: 220px; }
    #da-msg { opacity: .8; }
    /* Ligne en cours de lecture */
    .da-en-cours { outline: 3px solid #f1c40f; }
    .da-ligne-btn { margin-left: auto; flex-shrink: 0; padding: 0 8px; border: 0; border-radius: 6px; cursor: pointer; background-color: #345a93; font-size: 0.9em; }
    
</style>

<script src="/js/dialogue-audio.js" defer></script>



<%- include('../../../../partials/footer') %>


</html>