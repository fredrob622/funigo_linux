
<%- include('../../partials/header_honshu') %>


<div class="content content-black"> 
<div id=japon-ile-titre>
    <h2>île de Honshu</h2>
</div>

<body>

    <div id="box-contenaire1">
        <!-- diaporama -->
        <div id="box1">
            <a href="/video/japon/clip-honshu01.webm" target="_blank">
                <video autoplay loop muted playsinline>
                    <source src="/video/japon/clip-honshu01.webm" type="video/webm">
                </video>
            </a>
        </div>

            <!-- carte -->
        <div id="box2">
                <a href="/images/cartes/japon/honshu/carte-honshu-avec-ville.png" target="_blank">
                    <img src="/images/cartes/japon/honshu/carte-honshu-avec-ville.png" alt="Carte Honshu">
                </a>
        </div>
    </div>

    <div id="box-contenaire2">
        <!-- carte google maps -->
        <div id="box3">
            <p>box3</p>
            
            <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3269.7562479203926!2d135.7705118762514!3d34.96714016921389!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60010f153d2e6d21%3A0x7b1aca1c753ae2e9!2sFushimi%20Inari-taisha!5e0!3m2!1sfr!2sfr!4v1708500000000!5m2!1sfr!2sfr" 
                width="100%" 
                height="100%"  
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade">
            </iframe>
            
        </div>

        <!-- video youtube -->
        <div id="box4">
            <p>box4</p>

            <iframe 
                width=100%
                height=100%
                
                src="https://www.youtube.com/embed/Fv9K8wFZRrk?autoplay=1&mute=1&loop=1&playlist=Fv9K8wFZRrk&playsinline=1" 
                title="YouTube video player" 
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
            </iframe>

                        <!-- Overlay transparent qui capte le clic -->
            <a 
                href="https://www.youtube.com/watch?v=Fv9K8wFZRrk" 
                target="_blank" 
                rel="noopener noreferrer"
                style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 10; cursor: pointer;">
            </a>

        </div>
    </div>
    </div>
        <div id="box5">
            <p>box5</p>
             <img src="/images/cartes/japon/honshu/kanto-region.jpg" alt="Carte Honshu"  >
        </div>
    </div>
</div>
</body>

<style>
        #box-titre {  display: block; background-color: rgb(42, 165, 118);  }
        h1 { padding: 2px 50px 2px 10px; }
        
        #box-contenaire1 {  display: flex; }
        
        #box1 { width: 47%; height: auto;  margin-right: 5px;}

        #box2 { width: 53%; height: auto; padding: 0; overflow: hidden; }

        #box1 video, #box2 img { width: 100%;  height: auto;  object-fit: cover;     display: block; }

        #box2 > a img { cursor: pointer; }

        #box-contenaire2 {    display: flex;     /* margin-top: 10px; */ }
        
        #box3 { width: 47%;  height: auto; background-color: brown; margin-right: 5px; overflow: hidden;}

        #box4 {  position: relative; width: 53%; height: auto;  overflow: hidden;   }

        

    @media screen and (max-width: 600px) {

        #box-contenaire1 { display: flex;   }

        /* #box-contenaire1 { display: flex;  flex-direction: row;  } */

        #box1 { width: 90%; height: auto; margin-right: 5px; margin: auto;   }

        #box2 { width: 100%; height: auto; margin: auto;  }

        #box-contenaire2 { display: flex; flex-direction: column;  }

        #box3 {  width: 100%;  height: auto;  margin-right: 5px}

        #box4 {  width: 100%;  height: auto;  margin-right: 5px}


    }
</style>


