  <!-- ******************* css -->

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      height: 100vh;
      display: flex;
    }
	
	#box-contenaire1 {  display: flex; }

    #box1 { width: 50%; height: auto; padding: 0; overflow: hidden; }

    #box1 img { width: 100%;  height: 100%;  object-fit: cover;  display: block; }

    #box1 > a img { cursor: pointer; }
            
    #box2 { width: 50%; height: auto;  margin-left: 15px;}



    #box-contenaire2 { display: grid; grid-template-columns: 1fr 1fr ; grid-template-rows: 1fr 1fr 1fr; width: 100%; height: 100vh; border: 3px solid black; }

    #box4 { grid-column: 1; grid-row: 1; border: 3px solid black; }

    #box4 video { width: 132%;  height: auto;  object-fit: cover;  display: block;  margin-left: -80px; }
    
    #box5 {
      grid-column: 1;
      grid-row: 2;
      border: 3px solid black;
    }

    #box6 {
      grid-column: 2;
      grid-row: 1 / span 3;
      border: 3px solid black;
    }
	
	#box7 {
      grid-column: 1;
      grid-row: 3;
      border: 3px solid black;
    }


    @media screen and (max-width: 600px) {

        #box-contenaire1 { display: flex;  flex-direction: column; }

        /* #box-contenaire1 { display: flex;  flex-direction: row;  } */

        #box1 { width: 90%; height: auto; margin-right: 5px; margin: auto;   }

        #box2 { width: 90%; height: auto; margin-left: 15px; margin: auto;  margin-top: 10px; }

        
        #box-contenaire2 { display: flex;   }

        #box4 { width: 100%; height: auto;  margin-bottom: 10px; justify-content:  center; margin: auto; }

    }


  </style>
